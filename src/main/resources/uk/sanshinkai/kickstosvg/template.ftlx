<?xml version="1.0" encoding="UTF-8"?>
<#-- The basics: paper and column sizes (in points; 1pt = 1/72" or 0.3527mm) -->
<#assign paperHeight = 595>
<#assign paperWidth = 842>
<#assign columnWidth = 56>
<#assign columnSpace = 9>
<#assign cellHeight = 36>
<#assign cellWidth = columnWidth / 2>

<#-- Canvas size and margins are computed from above; don't change these -->
<#assign canvasWidth = columnWidth * columnsPerPage + columnSpace * (columnsPerPage - 1) >
<#assign canvasHeight = cellHeight * cellsPerCol >
<#assign marginX = (paperWidth - canvasWidth) / 2 >
<#assign marginY = (paperHeight - canvasHeight) / 2 >

<#-- Font sizes -->
<#assign fsLyrics = 10>
<#assign fsTitleFurigana = 12>
<#assign fsTitleJapanese = 26>
<#assign fsTitleLatin = 14>
<#assign fsTuning = 14>
<#assign fsNote = 18><#-- no effect as we're using SVG notes -->

<#-- Notes -->
<#assign smallScale = 0.75 ><#-- relative size of small notes -->

<#-- Chord and slur lines -->
<#assign chordXOffset = 24.5>
<#assign slurXOffset = 3.5>
<#assign joinLineYOffset = fsNote / 4.0>

<#-- Repeat marks, with limits at top and bottom of canvas -->
<#assign repeatWidth = 21 >
<#assign repeatLength = cellHeight >
<#assign repeatMinY = cellHeight / -4.0 >
<#assign repeatMaxY = canvasHeight + cellHeight / 4.0 >

<#-- Lyrics -->
<#assign lyricXOffset = columnWidth * 5.0/8.0 >
<#assign lyricYOffset = fsLyrics / -2.0 >

<#-- Other styling can be altered in CSS below -->
<svg
  viewBox="${-marginX} ${-marginY} ${paperWidth} ${paperHeight}"
  width="${paperWidth}pt"
  height="${paperHeight}pt"
  version="1.1"
  >
  <style type="text/css">
    <![CDATA[
      svg {
        font-family: "EPSON 教科書体Ｍ";
        stroke-linecap: square;
        stroke-linejoin: miter;
      }
      #column {
        fill: none;
        stroke-width: 0.5;
        stroke: #969696;
      }
      #triangle_filled, #circle_filled {
        stroke: black;
        fill: black;
      }
      #triangle_outline, #circle_outline {
        stroke: black;
        fill: white;
      }
      .latin {
        font-family: "FreeSans";
      }
      .lyrics {
        font-size: ${fsLyrics};
        letter-spacing: -4;
        writing-mode: tb-rl;
      }
      .repeats {
        fill: none;
        stroke: black;
        stroke-width: 0.5;
      }
      .title {
        font-size: ${fsTitleJapanese};
        writing-mode: tb-rl;
      }
      .title .latin {
        font-size: ${fsTitleLatin};
      }
      .title .furigana {
        font-size: ${fsTitleFurigana};
      }
      .title .tuning {
        font-size: ${fsTuning};
      }
      .chord, .slur {
        stroke: black;
        stroke-width: 1;
        stroke-linecap: round;
      }
    ]]>
  </style>
  <defs>
    <!-- Repeat head styles -->
    <path id="rpt_triangle" d="M 4,0 L -4,-4 L -4,4 z" />
    <circle id="rpt_circle" cx="0" cy="0" r="4" />
    <marker
      id="rpt_triangle_filled"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_triangle" />
    </marker>
    <marker
      id="rpt_triangle_outline"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_triangle" />
    </marker>
    <marker
      id="rpt_circle_filled"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_circle" />
    </marker>
    <marker
      id="rpt_circle_outline"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_circle" />
    </marker>

    <!-- The note column grid -->
    <g id="column">
      <rect x="0" y="0" width="${columnWidth}" height="${canvasHeight}"/>
      <path d="M ${columnWidth / 2},0 v ${canvasHeight}"/>
      <#list 1..(cellsPerCol - 1) as i>
        <path d="M 0,${cellHeight * i} h ${columnWidth / 2}"/>
      </#list>
    </g>

    <!-- SVG notes etc. are interpolated here -->
    ${definitions?no_esc}
    <use id="mark_f1_small" href="#mark_f1" transform="scale(${smallScale})" />
    <use id="mark_f2_small" href="#mark_f2" transform="scale(${smallScale})" />
    <use id="mark_f3_small" href="#mark_f3" transform="scale(${smallScale})" />
    <use id="mark_f4_small" href="#mark_f4" transform="scale(${smallScale})" />
    <use id="mark_flat_small" href="#mark_flat" transform="scale(${smallScale})" />
    <use id="mark_kaki_small" href="#mark_kaki" transform="scale(${smallScale})" />
    <use id="mark_sharp_small" href="#mark_sharp" transform="scale(${smallScale})" />
    <use id="mark_uchi_small" href="#mark_uchi" transform="scale(${smallScale})" />
    <use id="mark_vend_small" href="#mark_vend" transform="scale(${smallScale})" />
    <use id="mark_vstart_small" href="#mark_vstart" transform="scale(${smallScale})" />
    <use id="note_ai_small" href="#note_ai" transform="scale(${smallScale})" />
    <use id="note_bon_small" href="#note_bon" transform="scale(${smallScale})" />
    <use id="note_gerou_small" href="#note_gerou" transform="scale(${smallScale})" />
    <use id="note_geshaku_small" href="#note_geshaku" transform="scale(${smallScale})" />
    <use id="note_go_small" href="#note_go" transform="scale(${smallScale})" />
    <use id="note_hachi_small" href="#note_hachi" transform="scale(${smallScale})" />
    <use id="note_iai_small" href="#note_iai" transform="scale(${smallScale})" />
    <use id="note_igo_small" href="#note_igo" transform="scale(${smallScale})" />
    <use id="note_ijou_small" href="#note_ijou" transform="scale(${smallScale})" />
    <use id="note_ikou_small" href="#note_ikou" transform="scale(${smallScale})" />
    <use id="note_iotsu_small" href="#note_iotsu" transform="scale(${smallScale})" />
    <use id="note_irou_small" href="#note_irou" transform="scale(${smallScale})" />
    <use id="note_ishaku_small" href="#note_ishaku" transform="scale(${smallScale})" />
    <use id="note_iyon_small" href="#note_iyon" transform="scale(${smallScale})" />
    <use id="note_jou_small" href="#note_jou" transform="scale(${smallScale})" />
    <use id="note_kou_small" href="#note_kou" transform="scale(${smallScale})" />
    <use id="note_kougo_small" href="#note_kougo" transform="scale(${smallScale})" />
    <use id="note_koujou_small" href="#note_koujou" transform="scale(${smallScale})" />
    <use id="note_kounaka_small" href="#note_kounaka" transform="scale(${smallScale})" />
    <use id="note_koushaku_small" href="#note_koushaku" transform="scale(${smallScale})" />
    <use id="note_kyuu_small" href="#note_kyuu" transform="scale(${smallScale})" />
    <use id="note_maru_small" href="#note_maru" transform="scale(${smallScale})" />
    <use id="note_naka_small" href="#note_naka" transform="scale(${smallScale})" />
    <use id="note_otsu_small" href="#note_otsu" transform="scale(${smallScale})" />
    <use id="note_roku_small" href="#note_roku" transform="scale(${smallScale})" />
    <use id="note_rou_small" href="#note_rou" transform="scale(${smallScale})" />
    <use id="note_sai_small" href="#note_sai" transform="scale(${smallScale})" />
    <use id="note_shaku8_small" href="#note_shaku8" transform="scale(${smallScale})" />
    <use id="note_shaku_small" href="#note_shaku" transform="scale(${smallScale})" />
    <use id="note_shichi_small" href="#note_shichi" transform="scale(${smallScale})" />
    <use id="note_yon_small" href="#note_yon" transform="scale(${smallScale})" />
  </defs>

  <#list columns as column>
    <#assign colX = (columnsPerPage - 1 - column.index) * (columnWidth + columnSpace)>

    <#if column.song??>

      <g class="title">
        <#assign song = column.song>
        <#assign ctr = colX + columnWidth / 2.0>
        <#if song.romaji??>
          <#assign jx = colX + fsTitleJapanese / 2.0>
          <#assign rx = colX + fsTitleJapanese + fsTitleFurigana + fsTitleLatin / 2.0>
          <text x="${rx}" y="0" class="latin">${song.romaji}</text>
        <#else>
          <#assign jx = ctr>
        </#if>

        <#assign fx = jx + fsTitleJapanese / 2.0 + fsTitleFurigana / 2.0>
        <#assign y = 0>
        <#list song.title as part>
          <#assign len = part.surface?length * fsTitleJapanese>
          <#if part.reading??>
            <#assign rlen = part.reading?length * fsTitleFurigana>
            <#assign len = [len, rlen]?max>
            <text x="${fx}" y="${y}" textLength="${len}" lengthAdjust="spacing"
              class="furigana">${part.reading}</text>
          </#if>
          <text x="${jx}" y="${y}" textLength="${len}" lengthAdjust="spacing">${part.surface}</text>
          <#assign y = y + len>
        </#list>

        <#assign tlen = song.tuning?length * fsTuning>
        <text x="${ctr}" y="${canvasHeight - tlen}" class="tuning"
          textLength="${tlen}" lengthAdjust="spacing">${song.tuning}</text>
      </g>

    <#else>

      <use href="#column" x="${colX}" y="0"/>

      <g class="notes">
      <#assign x = colX + cellWidth / 2 >
        <#list column.notes as note>
          <#assign y = note.y * cellHeight>
          <#assign suffix = note.small?string("_small", "")>
          <use href="#${note.name}${suffix}" x="${x}" y="${y}"/>
          <#if note.articulation??>
            <use href="#mark_${note.articulation}${suffix}" x="${x}" y="${y}"/>
          </#if>
          <#if note.accidental??>
            <use href="#mark_${note.accidental}${suffix}" x="${x}" y="${y}"/>
          </#if>
        </#list>

        <#assign x = colX + chordXOffset>
        <#list column.chords as chord>
          <#assign y0 = chord.startY * cellHeight - joinLineYOffset * chord.startSmall?then(smallScale,1)>
          <#assign y1 = chord.endY * cellHeight + joinLineYOffset * chord.endSmall?then(smallScale,1)>
          <path class="chord" d="M ${x},${y0} V ${y1}"/>
        </#list>

        <#assign x = colX + slurXOffset>
        <#list column.slurs as slur>
          <#assign y0 = slur.startY * cellHeight - joinLineYOffset * slur.startSmall?then(smallScale,1)>
          <#assign y1 = slur.endY * cellHeight + joinLineYOffset * slur.endSmall?then(smallScale,1)>
          <path class="slur" d="M ${x},${y0} V ${y1}"/>
        </#list>
      </g>

      <g class="lyrics">
        <#assign x = colX + lyricXOffset>
        <#list column.lyrics as lyric>
          <#assign y = lyric.y * cellHeight + lyricYOffset>
          <text x="${x}" y="${y}">${lyric.text}</text>
        </#list>
      </g>

      <g class="repeats">
        <#assign x = colX + cellWidth>
        <#list column.repeats as repeat>
          <#assign y0 = repeat.y * cellHeight>
          <#if repeat.back>
            <#assign y1 = [y0 - repeatLength, repeatMinY]?max>
          <#else>
            <#assign y1 = [y0 + repeatLength, repeatMaxY]?min>
          </#if>
          <path d="M ${x},${y0} h ${repeatWidth} V ${y1}"
            style="marker-end: url(#rpt_${repeat.style})"/>
        </#list>
      </g>

    </#if>
  </#list>
</svg>
