<?xml version="1.0" encoding="UTF-8"?>
<#--
All dimensions are in points; 1pt = 1/72" or 0.3527mm.

However, once we get into the world of SVG, points are now user units, which are
defined to be equal to one pixel, we can't use point measurements, and we have
to use px in CSS where we want points. Confusing!
-->

<#-- Basic dimensions of grid -->
<#assign columnWidth = 56>
<#assign columnSpace = 9>
<#assign cellWidth = 28>
<#assign cellHeight = 36>

<#-- A4 landscape; might be overridden by shrinkToFit option -->
<#assign paperWidth = 842.1>
<#assign paperHeight = 595.4>

<#-- Font sizes -->
<#assign fsLyrics = 10>
<#assign fsTitleFurigana = 12>
<#assign fsTitleJapanese = 26>
<#assign fsTitleLatin = 14>
<#assign fsTuning = 14>
<#assign fsNotes = 18>

<#-- How big are small notes compared to large ones? -->
<#assign smallScale = 0.75>

<#-- Position of fingering numbers -->
<#assign fingerOffsetX = -4.5>

<#-- Chord and slur lines -->
<#assign chordXOffset = 24.5>
<#assign slurXOffset = 3.5>
<#-- How much do we extend the end of a slur/chord line from the centre? -->
<#assign joinLineOverlap = 5><#-- will be scaled for small notes -->

<#-- Lyrics -->
<#assign lyricXOffset = 35>
<#assign lyricYOffset = 0>

<#-- Repeats -->
<#assign repeatWidth = 21>
<#assign repeatLength = 36>

<#if shrinkToFit??>
  <#assign columnsPerPage = columns?size>
</#if>

<#-- Canvas size is computed from above; don't change these -->
<#assign canvasWidth = columnWidth * columnsPerPage + columnSpace * (columnsPerPage - 1) >
<#assign canvasHeight = cellHeight * cellsPerCol>

<#if shrinkToFit??>
  <#-- 1pt each side to avoid cropping lines -->
  <#assign paperWidth = canvasWidth + 2>
  <#-- ½ cell top and bottom for overflowing notes/repeats -->
  <#assign paperHeight = canvasHeight + cellHeight>
</#if>

<#-- Repeat mark limits at top and bottom of canvas -->
<#assign repeatMinY = cellHeight / -4.0>
<#assign repeatMaxY = canvasHeight + cellHeight / 4.0>

<#-- Computed from above -->
<#assign marginX = (paperWidth - canvasWidth) / 2>
<#assign marginY = (paperHeight - canvasHeight) / 2>
<#assign noteScaleL = fsNotes / 18.0><#-- 18 is nominal size of SVG kanji -->
<#assign noteScaleS = noteScaleL * smallScale>

<#-- Other styling can be altered in CSS below -->
<svg
  viewBox="${-marginX} ${-marginY} ${paperWidth} ${paperHeight}"
  width="${paperWidth}"
  height="${paperHeight}"
  version="1.1"
  xmlns="http://www.w3.org/2000/svg"
  xmlns:svg="http://www.w3.org/2000/svg">
  <style type="text/css">
    <![CDATA[
      svg {
        font-family: "EPSON 教科書体Ｍ", serif;
        stroke-linecap: square;
        stroke-linejoin: miter;
      }
      #column {
        fill: none;
        stroke-width: 0.5px;
        stroke: #969696;
      }
      #rpt_triangle_filled, #rpt_circle_filled {
        overflow: visible;
        stroke-width: 1px;
        stroke: black;
        fill: black;
      }
      #rpt_triangle_outline, #rpt_circle_outline {
        overflow: visible;
        stroke-width: 1px;
        stroke: black;
        fill: white;
      }
      .latin {
        font-family: "FreeSans", sans-serif;
      }
      .lyrics {
        font-size: ${fsLyrics}px;
        letter-spacing: -4px;
        writing-mode: tb-rl;
      }
      .repeats {
        fill: none;
        stroke: black;
        stroke-width: 0.5px;
      }
      .title {
        writing-mode: tb-rl;
      }
      .title .surface {
        font-size: ${fsTitleJapanese}px;
      }
      .title .latin {
        font-size: ${fsTitleLatin}px;
        writing-mode: lr-tb;
      }
      .title .furigana {
        font-size: ${fsTitleFurigana}px;
      }
      .title .tuning {
        font-size: ${fsTuning}px;
      }
      .chord, .slur {
        stroke: black;
        stroke-width: 1px;
        stroke-linecap: round;
      }
    ]]>
  </style>
  <defs>
    <#-- Repeat head styles -->
    <path id="rpt_triangle" d="M 4,0 L -4,-4 L -4,4 z" />
    <circle id="rpt_circle" cx="0" cy="0" r="4" />
    <marker
      id="rpt_triangle_filled"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth">
      <use href="#rpt_triangle" />
    </marker>
    <marker
      id="rpt_triangle_outline"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth">
      <use href="#rpt_triangle" />
    </marker>
    <marker
      id="rpt_circle_filled"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth">
      <use href="#rpt_circle" />
    </marker>
    <marker
      id="rpt_circle_outline"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth">
      <use href="#rpt_circle" />
    </marker>

    <#-- The note column grid -->
    <g id="column">
      <rect x="0" y="0" width="${columnWidth}" height="${canvasHeight}"/>
      <path d="M ${columnWidth / 2},0 v ${canvasHeight}"/>
      <#list 1..(cellsPerCol - 1) as i>
        <path d="M 0,${cellHeight * i} h ${columnWidth / 2}"/>
      </#list>
    </g>

    <#-- SVG notes etc. are interpolated here -->
    ${definitions?no_esc}
  </defs>

  <#list columns as column>
    <#assign colX = (columnsPerPage - 1 - column.index) * (columnWidth + columnSpace)>

    <#if column.song??>

      <g class="title">
        <#assign song = column.song>
        <#assign ctr = colX + columnWidth / 2.0>
        <#if song.romaji??>
          <#assign jx = colX + fsTitleJapanese / 2.0>
          <#assign rx = colX + fsTitleJapanese + fsTitleFurigana + fsTitleLatin / 2.0>
          <g transform="translate(${rx} 0)">
            <text class="latin" transform="rotate(90)">${song.romaji}</text>
          </g>
        <#else>
          <#assign jx = ctr>
        </#if>

        <#assign fx = jx + fsTitleJapanese / 2.0 + fsTitleFurigana / 2.0>
        <#assign y = 0>
        <#list song.title as part>
          <#assign len = part.surface?length * fsTitleJapanese>
          <#if part.reading??>
            <#assign rlen = part.reading?length * fsTitleFurigana>
            <#assign len = [len, rlen]?max>
            <text x="${fx}" y="${y}" textLength="${len}" lengthAdjust="spacing"
              class="furigana">${part.reading}</text>
          </#if>
          <text x="${jx}" y="${y}" textLength="${len}" lengthAdjust="spacing"
            class="surface">${part.surface}</text>
          <#assign y = y + len>
        </#list>

        <#assign tlen = song.tuning?length * fsTuning>
        <text x="${ctr}" y="${canvasHeight - tlen}" class="tuning"
          textLength="${tlen}" lengthAdjust="spacing">${song.tuning}</text>
      </g>

    <#else>

      <use href="#column" x="${colX}" y="0"/>

      <g class="notes">
        <#assign x = colX + cellWidth / 2 >
        <#list column.notes as note>
          <#assign y = note.pos * cellHeight>
          <g transform="translate(${x} ${y})">
            <#assign scale = note.small?then(noteScaleS,noteScaleL)>
            <g transform="scale(${scale})">
              <use href="#${note.name}" />
              <#if note.articulation??>
                <use href="#${note.articulation}" />
              </#if>
              <#if note.accidental??>
                <use href="#${note.accidental}" />
              </#if>
            </g>
          </g>
          <#if note.finger??>
            <g transform="translate(${colX + fingerOffsetX} ${y})">
              <use href="#${note.finger}" transform="scale(${noteScaleL})"/>
            </g>
          </#if>
        </#list>

        <#assign x = colX + chordXOffset>
        <#list column.chords as chord>
          <#assign y0 = chord.top * cellHeight - joinLineOverlap * chord.startSmall?then(smallScale,1)>
          <#assign y1 = chord.bottom * cellHeight + joinLineOverlap * chord.endSmall?then(smallScale,1)>
          <path class="chord" d="M ${x},${y0} V ${y1}"/>
        </#list>

        <#assign x = colX + slurXOffset>
        <#list column.slurs as slur>
          <#assign y0 = slur.top * cellHeight - joinLineOverlap * slur.startSmall?then(smallScale,1)>
          <#assign y1 = slur.bottom * cellHeight + joinLineOverlap * slur.endSmall?then(smallScale,1)>
          <path class="slur" d="M ${x},${y0} V ${y1}"/>
        </#list>
      </g>

      <#if column.lyrics??>
        <g class="lyrics">
          <#assign x = colX + lyricXOffset>
          <#list column.lyrics as lyric>
            <#-- Vertical text starts at top middle. Move up to centre first char -->
            <#assign y = lyric.pos * cellHeight - fsLyrics / 2 + lyricYOffset>
            <text x="${x}" y="${y}">${lyric.text}</text>
          </#list>
        </g>
      </#if>

      <#if column.repeats??>
        <g class="repeats">
          <#assign x = colX + cellWidth>
          <#list column.repeats as repeat>
            <#assign y0 = repeat.pos * cellHeight>
            <#if repeat.back>
              <#assign y1 = [y0 - repeatLength, repeatMinY]?max>
            <#else>
              <#assign y1 = [y0 + repeatLength, repeatMaxY]?min>
            </#if>
            <path d="M ${x},${y0} h ${repeatWidth} V ${y1}"
              style="marker-end: url(#rpt_${repeat.style})"/>
          </#list>
        </g>
      </#if>

    </#if>
  </#list>
</svg>
