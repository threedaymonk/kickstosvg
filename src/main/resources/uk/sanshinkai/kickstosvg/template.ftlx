<?xml version="1.0" encoding="UTF-8"?>
<#-- The basics: paper and column sizes (in points; 1pt = 1/72" or 0.3527mm) -->
<#assign paperHeight = 595.4>
<#assign paperWidth = 842.1>
<#assign columnWidth = 56>
<#assign columnSpace = 9>
<#assign cellHeight = 36>
<#assign cellWidth = columnWidth / 2>

<#-- Canvas size and margins are computed from above; don't change these -->
<#assign canvasWidth = columnWidth * columnsPerPage + columnSpace * (columnsPerPage - 1) >
<#assign canvasHeight = cellHeight * cellsPerCol >
<#assign marginX = (paperWidth - canvasWidth) / 2 >
<#assign marginY = (paperHeight - canvasHeight) / 2 >

<#-- Font sizes -->
<#assign fsLyrics = 10>
<#assign fsTitleFurigana = 12>
<#assign fsTitleJapanese = 26>
<#assign fsTitleLatin = 14>
<#assign fsTuning = 14>
<#assign fsNote = 18>

<!-- How big are small notes compared to large ones? -->
<#assign smallScale = 0.75>

<#-- Scales are computed from font sizes and scale above; don't change these -->
<#assign noteScaleL = fsNote / 18.0><!-- 18 is nominal size of SVG kanji -->
<#assign noteScaleS = noteScaleL * smallScale>

<#-- Chord and slur lines -->
<#assign chordXOffset = 24.5>
<#assign slurXOffset = 3.5>
<#assign joinLineYOffset = fsNote / 4.0>

<#-- Repeat marks, with limits at top and bottom of canvas -->
<#assign repeatWidth = 21 >
<#assign repeatLength = cellHeight >
<#assign repeatMinY = cellHeight / -4.0 >
<#assign repeatMaxY = canvasHeight + cellHeight / 4.0 >

<#-- Lyrics -->
<#assign lyricXOffset = columnWidth * 5.0/8.0 >
<#assign lyricYOffset = fsLyrics / -2.0 >

<#-- Other styling can be altered in CSS below -->
<svg
  viewBox="${-marginX} ${-marginY} ${paperWidth} ${paperHeight}"
  width="${paperWidth}pt"
  height="${paperHeight}pt"
  version="1.1"
  >
  <style type="text/css">
    <![CDATA[
      svg {
        font-family: "EPSON 教科書体Ｍ";
        stroke-linecap: square;
        stroke-linejoin: miter;
      }
      #column {
        fill: none;
        stroke-width: 0.5;
        stroke: #969696;
      }
      #triangle_filled, #circle_filled {
        stroke: black;
        fill: black;
      }
      #triangle_outline, #circle_outline {
        stroke: black;
        fill: white;
      }
      .latin {
        font-family: "FreeSans";
      }
      .lyrics {
        font-size: ${fsLyrics};
        letter-spacing: -4;
        writing-mode: tb-rl;
      }
      .repeats {
        fill: none;
        stroke: black;
        stroke-width: 0.5;
      }
      .title {
        font-size: ${fsTitleJapanese};
        writing-mode: tb-rl;
      }
      .title .latin {
        font-size: ${fsTitleLatin};
        writing-mode: lr-tb;
      }
      .title .furigana {
        font-size: ${fsTitleFurigana};
      }
      .title .tuning {
        font-size: ${fsTuning};
      }
      .chord, .slur {
        stroke: black;
        stroke-width: 1;
        stroke-linecap: round;
      }
    ]]>
  </style>
  <defs>
    <!-- Repeat head styles -->
    <path id="rpt_triangle" d="M 4,0 L -4,-4 L -4,4 z" />
    <circle id="rpt_circle" cx="0" cy="0" r="4" />
    <marker
      id="rpt_triangle_filled"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_triangle" />
    </marker>
    <marker
      id="rpt_triangle_outline"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_triangle" />
    </marker>
    <marker
      id="rpt_circle_filled"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_circle" />
    </marker>
    <marker
      id="rpt_circle_outline"
      refX="0" refY="0" orient="auto"
      markerUnits="strokeWidth" style="stroke-width: 1">
      <use href="#rpt_circle" />
    </marker>

    <!-- The note column grid -->
    <g id="column">
      <rect x="0" y="0" width="${columnWidth}" height="${canvasHeight}"/>
      <path d="M ${columnWidth / 2},0 v ${canvasHeight}"/>
      <#list 1..(cellsPerCol - 1) as i>
        <path d="M 0,${cellHeight * i} h ${columnWidth / 2}"/>
      </#list>
    </g>

    <!-- SVG notes etc. are interpolated here -->
    ${definitions?no_esc}
  </defs>

  <#list columns as column>
    <#assign colX = (columnsPerPage - 1 - column.index) * (columnWidth + columnSpace)>

    <#if column.song??>

      <g class="title">
        <#assign song = column.song>
        <#assign ctr = colX + columnWidth / 2.0>
        <#if song.romaji??>
          <#assign jx = colX + fsTitleJapanese / 2.0>
          <#assign rx = colX + fsTitleJapanese + fsTitleFurigana + fsTitleLatin / 2.0>
          <text x="0" y="0" class="latin" transform="rotate(90) translate(0 ${-rx})">${song.romaji}</text>
        <#else>
          <#assign jx = ctr>
        </#if>

        <#assign fx = jx + fsTitleJapanese / 2.0 + fsTitleFurigana / 2.0>
        <#assign y = 0>
        <#list song.title as part>
          <#assign len = part.surface?length * fsTitleJapanese>
          <#if part.reading??>
            <#assign rlen = part.reading?length * fsTitleFurigana>
            <#assign len = [len, rlen]?max>
            <text x="${fx}" y="${y}" textLength="${len}" lengthAdjust="spacing"
              class="furigana">${part.reading}</text>
          </#if>
          <text x="${jx}" y="${y}" textLength="${len}" lengthAdjust="spacing">${part.surface}</text>
          <#assign y = y + len>
        </#list>

        <#assign tlen = song.tuning?length * fsTuning>
        <text x="${ctr}" y="${canvasHeight - tlen}" class="tuning"
          textLength="${tlen}" lengthAdjust="spacing">${song.tuning}</text>
      </g>

    <#else>

      <use href="#column" x="${colX}" y="0"/>

      <g class="notes">
        <#assign x = colX + cellWidth / 2 >
        <#list column.notes as note>
          <#assign y = note.y * cellHeight>
          <g transform="translate(${x} ${y})">
            <#assign scale = note.small?then(noteScaleS,noteScaleL)>
            <use href="#${note.name}" transform="scale(${scale})"/>
            <#if note.articulation??>
              <use href="#mark_${note.articulation}" transform="scale(${scale})"/>
            </#if>
            <#if note.accidental??>
              <use href="#mark_${note.accidental}" transform="scale(${scale})"/>
            </#if>
          </g>
        </#list>

        <#assign x = colX + chordXOffset>
        <#list column.chords as chord>
          <#assign y0 = chord.startY * cellHeight - joinLineYOffset * chord.startSmall?then(smallScale,1)>
          <#assign y1 = chord.endY * cellHeight + joinLineYOffset * chord.endSmall?then(smallScale,1)>
          <path class="chord" d="M ${x},${y0} V ${y1}"/>
        </#list>

        <#assign x = colX + slurXOffset>
        <#list column.slurs as slur>
          <#assign y0 = slur.startY * cellHeight - joinLineYOffset * slur.startSmall?then(smallScale,1)>
          <#assign y1 = slur.endY * cellHeight + joinLineYOffset * slur.endSmall?then(smallScale,1)>
          <path class="slur" d="M ${x},${y0} V ${y1}"/>
        </#list>
      </g>

      <g class="lyrics">
        <#assign x = colX + lyricXOffset>
        <#list column.lyrics as lyric>
          <#assign y = lyric.y * cellHeight + lyricYOffset>
          <text x="${x}" y="${y}">${lyric.text}</text>
        </#list>
      </g>

      <g class="repeats">
        <#assign x = colX + cellWidth>
        <#list column.repeats as repeat>
          <#assign y0 = repeat.y * cellHeight>
          <#if repeat.back>
            <#assign y1 = [y0 - repeatLength, repeatMinY]?max>
          <#else>
            <#assign y1 = [y0 + repeatLength, repeatMaxY]?min>
          </#if>
          <path d="M ${x},${y0} h ${repeatWidth} V ${y1}"
            style="marker-end: url(#rpt_${repeat.style})"/>
        </#list>
      </g>

    </#if>
  </#list>
</svg>
